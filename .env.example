NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

DATABASE_URL=postgresql://vekko:<local-password>@localhost:5433/vekko
REDIS_URL=redis://:<local-password>@localhost:6380
REDIS_KEY_PREFIX=vekko:development
REDIS_CONNECT_TIMEOUT_MS=5000

FIREBASE_PROJECT_ID=vekko-development
