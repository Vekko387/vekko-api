FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-development-key\n-----END PRIVATE KEY-----\n"

DEPENDENCY_HEALTH_TIMEOUT_MS=2000

THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
