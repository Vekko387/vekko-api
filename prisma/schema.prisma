generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PARTNER_OWNER
  PARTNER_MANAGER
  PARTNER_EMPLOYEE
  SUPER_ADMIN
  ADMIN
  SUPORTE
  FINANCEIRO
  COMERCIAL
  OPERACOES
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum VehicleType {
  HATCH
  SEDAN
  SUV
  PICKUP
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum PartnerApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

enum PartnerMemberRole {
  OWNER
  MANAGER
  EMPLOYEE
}

model User {
  id                          String               @id @default(uuid()) @db.Uuid
  firebaseUid                 String               @unique(map: "users_firebase_uid_key") @map("firebase_uid") @db.VarChar(128)
  email                       String?              @db.VarChar(320)
  status                      UserStatus           @default(ACTIVE)
  profile                     UserProfile?
  roles                       UserRole[]
  vehicles                    Vehicle[]
  partnerMemberships          PartnerMember[]
  reviewedPartnerApplications PartnerApplication[] @relation("PartnerApplicationReviewer")
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model UserProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique(map: "user_profiles_user_id_key") @map("user_id") @db.Uuid
  fullName           String?   @map("full_name") @db.VarChar(160)
  cpfNormalized      String?   @unique(map: "user_profiles_cpf_normalized_key") @map("cpf_normalized") @db.VarChar(11)
  phoneNormalized    String?   @map("phone_normalized") @db.VarChar(11)
  profileCompletedAt DateTime? @map("profile_completed_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_profiles")
}

model Vehicle {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  plateNormalized String        @unique(map: "vehicles_plate_normalized_key") @map("plate_normalized") @db.VarChar(7)
  type            VehicleType
  brand           String        @db.VarChar(80)
  model           String        @db.VarChar(80)
  color           String        @db.VarChar(50)
  year            Int?
  nickname        String?       @db.VarChar(60)
  status          VehicleStatus @default(ACTIVE)
  isPrimary       Boolean       @default(false) @map("is_primary")
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status], map: "vehicles_status_idx")
  @@index([type], map: "vehicles_type_idx")
  @@index([userId, status], map: "vehicles_user_id_status_idx")
  @@map("vehicles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  role       Role
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  @@id([userId, role])
  @@index([role], map: "user_roles_role_idx")
  @@map("user_roles")
}

model PartnerApplication {
  id                   String                   @id @default(uuid()) @db.Uuid
  legalName            String                   @map("legal_name") @db.VarChar(160)
  tradeName            String                   @map("trade_name") @db.VarChar(160)
  cnpjNormalized       String                   @map("cnpj_normalized") @db.VarChar(14)
  responsibleName      String                   @map("responsible_name") @db.VarChar(160)
  contactEmail         String                   @map("contact_email") @db.VarChar(320)
  contactPhone         String                   @map("contact_phone") @db.VarChar(13)
  postalCodeNormalized String                   @map("postal_code_normalized") @db.VarChar(8)
  street               String                   @db.VarChar(160)
  addressNumber        String                   @map("address_number") @db.VarChar(30)
  addressComplement    String?                  @map("address_complement") @db.VarChar(120)
  neighborhood         String                   @db.VarChar(120)
  city                 String                   @db.VarChar(120)
  state                String                   @db.Char(2)
  businessCategory     String                   @map("business_category") @db.VarChar(100)
  serviceDescription   String                   @map("service_description") @db.VarChar(1000)
  status               PartnerApplicationStatus @default(PENDING_REVIEW)
  termsAcceptedAt      DateTime                 @map("terms_accepted_at") @db.Timestamptz(3)
  submittedAt          DateTime                 @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt           DateTime?                @map("reviewed_at") @db.Timestamptz(3)
  reviewedById         String?                  @map("reviewed_by_id") @db.Uuid
  rejectionReason      String?                  @map("rejection_reason") @db.VarChar(500)
  invitationSentAt     DateTime?                @map("invitation_sent_at") @db.Timestamptz(3)
  reviewedBy           User?                    @relation("PartnerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  partner              Partner?
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([contactEmail], map: "partner_applications_contact_email_idx")
  @@index([status, submittedAt], map: "partner_applications_status_submitted_at_idx")
  @@map("partner_applications")
}

model Partner {
  id                   String             @id @default(uuid()) @db.Uuid
  applicationId        String             @unique(map: "partners_application_id_key") @map("application_id") @db.Uuid
  legalName            String             @map("legal_name") @db.VarChar(160)
  tradeName            String             @map("trade_name") @db.VarChar(160)
  cnpjNormalized       String             @unique(map: "partners_cnpj_normalized_key") @map("cnpj_normalized") @db.VarChar(14)
  contactEmail         String             @map("contact_email") @db.VarChar(320)
  contactPhone         String             @map("contact_phone") @db.VarChar(13)
  postalCodeNormalized String             @map("postal_code_normalized") @db.VarChar(8)
  street               String             @db.VarChar(160)
  addressNumber        String             @map("address_number") @db.VarChar(30)
  addressComplement    String?            @map("address_complement") @db.VarChar(120)
  neighborhood         String             @db.VarChar(120)
  city                 String             @db.VarChar(120)
  state                String             @db.Char(2)
  businessCategory     String             @map("business_category") @db.VarChar(100)
  serviceDescription   String             @map("service_description") @db.VarChar(1000)
  status               PartnerStatus      @default(ACTIVE)
  application          PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  members              PartnerMember[]
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("partners")
}

model PartnerMember {
  partnerId String            @map("partner_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      PartnerMemberRole
  partner   Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([partnerId, userId])
  @@index([userId], map: "partner_members_user_id_idx")
  @@map("partner_members")
}
